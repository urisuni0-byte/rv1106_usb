#!/bin/sh
# UVC 카메라 MJPEG -> HTTP 스트리밍 (uvc_stream.py)
# /etc/init.d/S95uvcstream - Buildroot init (systemd 없음)
#
# 감시 루프가 start.sh 를 실행하고, 카메라가 없거나 프로세스가 죽으면 5초 뒤 다시 띄운다.
# (카메라를 나중에 꽂아도, 빼었다 꽂아도 자동으로 붙는다)
DIR=/opt/uvc-stream
LOG=/tmp/uvc-stream.log
PIDFILE=/var/run/uvc-stream.pid

supervise() {
    while true; do
        [ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 1048576 ] && : >"$LOG"
        echo "=== start $(date) ===" >>"$LOG"
        sh "$DIR/start.sh" >>"$LOG" 2>&1
        echo "=== exit $? $(date), restart in 5s ===" >>"$LOG"
        sleep 5
    done
}

case "$1" in
start)
    echo "Starting uvc-stream"
    start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- "$0" supervise
    ;;
stop)
    echo "Stopping uvc-stream"
    start-stop-daemon -K -q -p "$PIDFILE"
    rm -f "$PIDFILE"
    pkill -f "$DIR/uvc_stream.py" 2>/dev/null
    ;;
restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
supervise)
    supervise
    ;;
status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "running"
        tail -5 "$LOG"
    else
        echo "stopped"
    fi
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
